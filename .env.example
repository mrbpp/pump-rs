# Solana RPC Configuration
# CRITICAL: Use a paid RPC provider for production (Helius, QuickNode, Triton)
# Free public RPC will rate-limit you and you'll miss opportunities
RPC_URL=https://api.mainnet-beta.solana.com

# Solana WebSocket URL (for real-time slot updates and transaction logs)
# Must be WebSocket endpoint (wss://) matching your RPC provider
# Free: wss://api.mainnet-beta.solana.com (rate-limited)
# Helius: wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# QuickNode: wss://your-endpoint.quiknode.pro/YOUR_KEY
# Shyft: wss://rpc.shyft.to?api_key=YOUR_KEY
WS_URL=wss://api.mainnet-beta.solana.com

# Wallet Configuration
# Path to your main trading wallet keypair JSON file
FUND_KEYPAIR_PATH=/path/to/your/wallet-keypair.json

# Jito Configuration (for MEV bundles)
# Path to your Jito authentication keypair
AUTH_KEYPAIR_PATH=/path/to/jito-auth-keypair.json

# Jito Block Engine URL
# Available regions: amsterdam, frankfurt, ny, tokyo
BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Optional: For launching tokens with metadata
# Get these from https://infura.io
INFURA_PROJECT=your_infura_project_id
INFURA_SECRET=your_infura_secret

# Optional: For bump trading feature
BUMP_KEYPAIR_PATH=/path/to/bump-wallet-keypair.json

# Logging Configuration
# Options: trace, debug, info, warn, error
RUST_LOG=info
